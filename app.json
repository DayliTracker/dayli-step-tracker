{
  "expo": {
    "platforms": [
      "ios"
    ],
    "name": "Dayli Step Tracker",
    "slug": "dayli-step-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.daylitracker.dayli",
      "infoPlist": {
        "NSHealthShareUsageDescription": "Dayli reads your daily step count from Apple Health to show your progress. Read-only — Dayli never writes health data."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-localization"
    ]
  }
}
